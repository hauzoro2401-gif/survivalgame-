  m_Name: Dialogue_Ngay5
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: dialogue_day5
  description: "M\xF4 t\u1EA3 ng\u1EAFn v\u1EC1 \u0111o\u1EA1n tho\u1EA1i"
  lines:
  - speaker: 2
    text: "N\xF3 to l\u1EAFm. T\xF4i nh\xECn th\u1EA5y b\xF3ng n\xF3 t\u1EEB ph\xEDa
      B\u1EAFc \u2014 to b\u1EB1ng c\xE1i nh\xE0."
    emotion: 
  - speaker: 3
    text: "K\u1EBB G\xE1c C\u1ED5ng... Linh, m\u1EA3nh lore c\u1EADu \u0111\u1ECDc
      v\u1EC1 n\xF3 n\xF3i g\xEC?"
    emotion: 
  - speaker: 1
    text: "N\xF3i r\u1EB1ng n\xF3 t\u1EEBng l\xE0 ng\u01B0\u1EDDi. R\u1EB1ng n\xF3
      s\u1EE3 \xE1nh s\xE1ng tinh th\u1EC3."
    emotion: 
  - speaker: 0
    text: "Th\xEC ch\xFAng ta c\u1EA7n tinh th\u1EC3. T\u1EA5t c\u1EA3 s\u1EB5n s\xE0ng
      ch\u01B0a?"
    emotion: 
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
