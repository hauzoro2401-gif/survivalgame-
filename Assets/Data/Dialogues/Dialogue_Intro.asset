--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 0}
  m_Name: Dialogue_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: dialogue_intro
  description: "M\xF4 t\u1EA3 ng\u1EAFn v\u1EC1 \u0111o\u1EA1n tho\u1EA1i"
  lines:
  - speaker: 0
    text: "...C\u1EADu \u1ED5n kh\xF4ng? Trang, tr\u1EA3 l\u1EDDi t\xF4i!"
    emotion: 
  - speaker: 3
    text: "T\xF4i... \u1ED5n. \u0110au \u0111\u1EA7u m\u1ED9t ch\xFAt. Ch\xFAng ta
      \u0111ang \u1EDF \u0111\xE2u v\u1EADy?"
    emotion: 
  - speaker: 2
    text: "Kh\xF4ng bi\u1EBFt. Nh\u01B0ng \xE1nh s\xE1ng \u1EDF \u0111\xE2y... kh\xF4ng
      b\xECnh th\u01B0\u1EDDng."
    emotion: 
  - speaker: 1
    text: "C\u1ED5ng s\xE1ng \u0111\xF3 \u2014 ch\xFAng ta b\u01B0\u1EDBc qua n\xF3
      r\u1ED3i. Gi\u1EDD kh\xF4ng th\u1EC3 quay l\u1EA1i ngay."
    emotion: 
  - speaker: 0
    text: "\u0110\u01B0\u1EE3c r\u1ED3i. T\u1EADp h\u1EE3p l\u1EA1i. Ch\xFAng ta
      c\u1EA7n t\xECm n\u01B0\u1EDBc v\xE0 n\u01A1i tr\xFA \u1EA9n tr\u01B0\u1EDBc."
    emotion: 
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
