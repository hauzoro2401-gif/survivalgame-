  m_Name: Dialogue_Ngay7
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: dialogue_day7
  description: "M\xF4 t\u1EA3 ng\u1EAFn v\u1EC1 \u0111o\u1EA1n tho\u1EA1i"
  lines:
  - speaker: 1
    text: "\u0110\xE2y l\xE0 ng\xE0y th\u1EE9 7. C\u1ED5ng y\u1EBFu nh\u1EA5t l\xFAc
      n\xE0y."
    emotion: 
  - speaker: 0
    text: "Ch\xFAng ta \u0111\xE3 l\xE0m \u0111\u01B0\u1EE3c \u2014 s\u1ED1ng s\xF3t
      7 ng\xE0y \u1EDF \u0111\xE2y."
    emotion: 
  - speaker: 3
    text: "D\xF9 \u0111i\u1EC1u g\xEC x\u1EA3y ra sau c\u1ED5ng... t\xF4i kh\xF4ng
      h\u1ED1i h\u1EADn \u0111\xE3 \u1EDF \u0111\xE2y v\u1EDBi c\xE1c c\u1EADu."
    emotion: 
  - speaker: 2
    text: "\u0110\u1EEBng c\xF3 \u1EE7y m\u1ECB v\u1EADy. \u0110i th\xF4i!"
    emotion: 
  - speaker: 0
    text: "\u0110\xFAng r\u1ED3i. C\xF9ng nhau. Nh\u01B0 t\u1EEB \u0111\u1EA7u \u0111\u1EBFn
      gi\u1EDD."
    emotion: 
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
