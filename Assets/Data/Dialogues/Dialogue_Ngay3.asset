  m_Script: {fileID: 0}
  m_Name: Dialogue_Ngay3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: dialogue_day3
  description: "M\xF4 t\u1EA3 ng\u1EAFn v\u1EC1 \u0111o\u1EA1n tho\u1EA1i"
  lines:
  - speaker: 1
    text: "T\xF4i d\u1ECBch \u0111\u01B0\u1EE3c r\u1ED3i! Ch\u1EEF tr\xEAn v\xE1ch
      l\xE0 \u2014 'Ai v\xE0o \u0111\xE2y t\u1EF1 nguy\u1EC7n hay b\u1ECB k\xE9o?'"
    emotion: 
  - speaker: 2
    text: "C\xE2u h\u1ECFi k\u1EF3 l\u1EA1. \xDD n\xF3 l\xE0 sao?"
    emotion: 
  - speaker: 1
    text: "C\xF3 l\u1EBD... c\xF3 ai \u0111\xF3 \u0111\xE3 m\u1EDF c\u1ED5ng \u0111\xF3
      t\u1EEB ph\xEDa b\xEAn kia."
    emotion: 
  - speaker: 3
    text: "Ho\u1EB7c t\u1EEB ph\xEDa n\xE0y. \u0110\u1EC3 d\u1EABn ch\xFAng ta v\xE0o."
    emotion: 
  - speaker: 0
    text: "D\xF9 sao th\xEC \u2014 m\u1EE5c ti\xEAu kh\xF4ng \u0111\u1ED5i. Ch\xFAng
      ta c\u1EA7n t\xECm \u0111\u01B0\u1EDDng ra."
    emotion: 
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
